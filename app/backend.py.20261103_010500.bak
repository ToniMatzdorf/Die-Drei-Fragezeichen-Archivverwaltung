# ============================================================
# FALLAKTE – WEITERE FIGUREN AUS GEMEINSAMEN HÖRSPIELFOLGEN
# ============================================================

@app.get("/api/persons/{person_id}/related-figures")
def get_related_figures(person_id: int):
    try:
        with get_connection() as conn:

            person = conn.execute(
                "SELECT id FROM persons WHERE id = ?",
                (person_id,)
            ).fetchone()

            if person is None:
                raise HTTPException(
                    status_code=404,
                    detail="Figur nicht gefunden."
                )

            rows = conn.execute(
                """
                SELECT
                    p.id AS person_id,
                    p.name AS person_name,
                    p.description AS person_description,
                    a.alias AS person_alias,
                    e.id AS episode_id,
                    e.episode_number,
                    e.title AS episode_title,
                    ep.role,
                    ep.notes
                FROM episode_persons current_ep
                JOIN episode_persons ep
                    ON ep.episode_id = current_ep.episode_id
                JOIN persons p
                    ON p.id = ep.person_id
                JOIN episodes e
                    ON e.id = ep.episode_id
                LEFT JOIN person_aliases a
                    ON a.person_id = p.id
                WHERE current_ep.person_id = ?
                  AND ep.person_id != ?
                ORDER BY
                    p.name COLLATE NOCASE,
                    e.episode_number,
                    a.alias COLLATE NOCASE
                """,
                (person_id, person_id)
            ).fetchall()

            related = {}

            for row in rows:
                other_id = row["person_id"]

                if other_id not in related:
                    related[other_id] = {
                        "person_id": other_id,
                        "name": row["person_name"],
                        "description": row["person_description"],
                        "aliases": [],
                        "episodes": []
                    }

                figure = related[other_id]

                if row["person_alias"] and (
                    row["person_alias"] not in figure["aliases"]
                ):
                    figure["aliases"].append(row["person_alias"])

                episode_data = {
                    "episode_id": row["episode_id"],
                    "episode_number": row["episode_number"],
                    "title": row["episode_title"],
                    "role": row["role"],
                    "notes": row["notes"]
                }

                if not any(
                    episode["episode_id"] == row["episode_id"]
                    for episode in figure["episodes"]
                ):
                    figure["episodes"].append(episode_data)

        return sorted(
            related.values(),
            key=lambda figure: figure["name"].casefold()
        )

    except HTTPException:
        raise

    except Exception as error:
        raise HTTPException(
            status_code=500,
            detail=str(error)
        )


# ============================================================
# GLOBALE ARCHIVSUCHE
# ============================================================

@app.get("/api/search")
def global_search(q: str = ""):
    search_term = q.strip()

    if len(search_term) < 2:
        return []

    pattern = "%" + search_term + "%"

    try:
        results = []

        with get_connection() as conn:

            # Hörspielfolgen
            rows = conn.execute(
                """
                SELECT id, episode_number, title, synopsis, notes
                FROM episodes
                WHERE title LIKE ?
                   OR CAST(episode_number AS TEXT) LIKE ?
                   OR synopsis LIKE ?
                   OR notes LIKE ?
                ORDER BY episode_number
                LIMIT 50
                """,
                (pattern, pattern, pattern, pattern)
            ).fetchall()

            for row in rows:
                results.append({
                    "type": "Hörspielfolge",
                    "id": row["id"],
                    "title": "Folge " + str(row["episode_number"]) + " – " + row["title"],
                    "description": row["synopsis"] or row["notes"] or ""
                })

            # Personen und Figuren einschließlich Aliase
            rows = conn.execute(
                """
                SELECT DISTINCT p.id, p.name, p.description
                FROM persons p
                LEFT JOIN person_aliases a ON a.person_id = p.id
                WHERE p.name LIKE ?
                   OR p.description LIKE ?
                   OR a.alias LIKE ?
                ORDER BY p.name COLLATE NOCASE
                LIMIT 50
                """,
                (pattern, pattern, pattern)
            ).fetchall()

            for row in rows:
                results.append({
                    "type": "Person / Figur",
                    "id": row["id"],
                    "title": row["name"],
                    "description": row["description"] or ""
                })

            # Sprecher einschließlich alternativer Namen
            rows = conn.execute(
                """
                SELECT DISTINCT s.id, s.name, s.biography, s.notes
                FROM speakers s
                LEFT JOIN speaker_aliases a ON a.speaker_id = s.id
                WHERE s.name LIKE ?
                   OR s.biography LIKE ?
                   OR s.notes LIKE ?
                   OR a.alias LIKE ?
                ORDER BY s.name COLLATE NOCASE
                LIMIT 50
                """,
                (pattern, pattern, pattern, pattern)
            ).fetchall()

            for row in rows:
                results.append({
                    "type": "Sprecher",
                    "id": row["id"],
                    "title": row["name"],
                    "description": row["biography"] or row["notes"] or ""
                })

            # Schauplätze
            rows = conn.execute(
                """
                SELECT id, name, description
                FROM places
                WHERE name LIKE ? OR description LIKE ?
                ORDER BY name COLLATE NOCASE
                LIMIT 50
                """,
                (pattern, pattern)
            ).fetchall()

            for row in rows:
                results.append({
                    "type": "Schauplatz",
                    "id": row["id"],
                    "title": row["name"],
                    "description": row["description"] or ""
                })

            # Gegenstände
            rows = conn.execute(
                """
                SELECT id, name, description
                FROM objects
                WHERE name LIKE ? OR description LIKE ?
                ORDER BY name COLLATE NOCASE
                LIMIT 50
                """,
                (pattern, pattern)
            ).fetchall()

            for row in rows:
                results.append({
                    "type": "Gegenstand",
                    "id": row["id"],
                    "title": row["name"],
                    "description": row["description"] or ""
                })

            # Kreaturen und Monster
            rows = conn.execute(
                """
                SELECT id, name, description
                FROM creatures
                WHERE name LIKE ? OR description LIKE ?
                ORDER BY name COLLATE NOCASE
                LIMIT 50
                """,
                (pattern, pattern)
            ).fetchall()

            for row in rows:
                results.append({
                    "type": "Kreatur / Monster",
                    "id": row["id"],
                    "title": row["name"],
                    "description": row["description"] or ""
                })

            # Organisationen
            rows = conn.execute(
                """
                SELECT id, name, description
                FROM organizations
                WHERE name LIKE ? OR description LIKE ?
                ORDER BY name COLLATE NOCASE
                LIMIT 50
                """,
                (pattern, pattern)
            ).fetchall()

            for row in rows:
                results.append({
                    "type": "Organisation",
                    "id": row["id"],
                    "title": row["name"],
                    "description": row["description"] or ""
                })

            # Schlagwörter
            rows = conn.execute(
                """
                SELECT id, name
                FROM keywords
                WHERE name LIKE ?
                ORDER BY name COLLATE NOCASE
                LIMIT 50
                """,
                (pattern,)
            ).fetchall()

            for row in rows:
                results.append({
                    "type": "Schlagwort",
                    "id": row["id"],
                    "title": row["name"],
                    "description": ""
                })

            # Quellen
            rows = conn.execute(
                """
                SELECT id, title, source_type, author, url, notes
                FROM sources
                WHERE title LIKE ?
                   OR source_type LIKE ?
                   OR author LIKE ?
                   OR url LIKE ?
                   OR notes LIKE ?
                ORDER BY title COLLATE NOCASE
                LIMIT 50
                """,
                (pattern, pattern, pattern, pattern, pattern)
            ).fetchall()

            for row in rows:
                description_parts = []

                if row["source_type"]:
                    description_parts.append(row["source_type"])

                if row["author"]:
                    description_parts.append(row["author"])

                if row["notes"]:
                    description_parts.append(row["notes"])

                results.append({
                    "type": "Quelle",
                    "id": row["id"],
                    "title": row["title"],
                    "description": " – ".join(description_parts),
                    "url": row["url"] or ""
                })

        return results

    except Exception as error:
        raise HTTPException(
            status_code=500,
            detail="Fehler bei der globalen Suche: " + str(error)
        )



# ============================================================
# PDF-EXPORT ? ERMITTLUNGS- UND FALLAKTEN
# ============================================================

def generate_casefiles_pdf(output_path, episode_id=None):
    """
    Erstellt eine PDF mit einer oder allen vorhandenen Fallakten.
    Die Daten stammen aus dem bestehenden Fallakten-Endpunkt.
    Gestaltung: Retro-Polizeiakte (Aktendeckel, Schreibmaschinenschrift,
    Stempel, Lochung).
    """

    from pathlib import Path
    from xml.sax.saxutils import escape

    from reportlab.lib import colors
    from reportlab.lib.enums import TA_CENTER
    from reportlab.lib.pagesizes import A4
    from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle
    from reportlab.lib.units import mm
    from reportlab.pdfbase import pdfmetrics
    from reportlab.pdfbase.ttfonts import TTFont
    from reportlab.platypus import (
        BaseDocTemplate,
        PageTemplate,
        Frame,
        NextPageTemplate,
        Flowable,
        Paragraph,
        Spacer,
        PageBreak,
        Table,
        TableStyle,
        KeepTogether
    )

    output_path = Path(output_path)

    if episode_id is None:
        episodes = list_episodes()

        if not episodes:
            raise ValueError(
                "Es sind noch keine Hörspielfolgen vorhanden. "
                "Der Gesamtexport wurde nicht erstellt."
            )

        episode_ids = [episode["id"] for episode in episodes]

    else:
        data = get_episode_casefile(int(episode_id))
        episode_ids = [int(episode_id)]

    # --------------------------------------------------------
    # Schriftarten: Schreibmaschine (Courier New) mit Umlauten.
    # Ersatz: eingebaute Courier-Schrift (unterstützt ebenfalls
    # deutsche Umlaute).
    # --------------------------------------------------------
    font_regular = "Courier"
    font_bold = "Courier-Bold"

    regular_path = Path(r"C:\Windows\Fonts\cour.ttf")
    bold_path = Path(r"C:\Windows\Fonts\courbd.ttf")

    if regular_path.exists() and bold_path.exists():
        try:
            if "TypewriterArchive" not in pdfmetrics.getRegisteredFontNames():
                pdfmetrics.registerFont(
                    TTFont("TypewriterArchive", str(regular_path))
                )
                pdfmetrics.registerFont(
                    TTFont("TypewriterArchive-Bold", str(bold_path))
                )

            font_regular = "TypewriterArchive"
            font_bold = "TypewriterArchive-Bold"
        except Exception:
            pass

    # --------------------------------------------------------
    # Farben der Retro-Akte
    # --------------------------------------------------------
    folder_color = colors.HexColor("#E3CC9A")    # Aktendeckel (Manila)
    folder_dark = colors.HexColor("#C9AE74")     # Kante / Reiter
    paper_color = colors.HexColor("#F4EDDC")     # vergilbtes Papier
    ink_color = colors.HexColor("#2A2622")       # Schreibmaschinentinte
    faded_ink = colors.HexColor("#6B6155")       # verblasste Tinte
    rule_color = colors.HexColor("#9C8A68")      # Linien
    label_color = colors.HexColor("#E9DDBF")     # Formularfelder
    stamp_red = colors.HexColor("#A8261D")       # Stempelfarbe

    page_width, page_height = A4

    styles = getSampleStyleSheet()

    styles.add(ParagraphStyle(
        name="RetroAuthority",
        parent=styles["Normal"],
        fontName=font_bold,
        fontSize=11,
        leading=14,
        alignment=TA_CENTER,
        textColor=ink_color
    ))

    styles.add(ParagraphStyle(
        name="RetroAuthoritySmall",
        parent=styles["Normal"],
        fontName=font_regular,
        fontSize=8.5,
        leading=11,
        alignment=TA_CENTER,
        textColor=faded_ink
    ))

    styles.add(ParagraphStyle(
        name="RetroCoverTitle",
        parent=styles["Title"],
        fontName=font_bold,
        fontSize=30,
        leading=36,
        alignment=TA_CENTER,
        textColor=ink_color,
        spaceAfter=2 * mm
    ))

    styles.add(ParagraphStyle(
        name="RetroCoverCase",
        parent=styles["Normal"],
        fontName=font_bold,
        fontSize=14,
        leading=18,
        alignment=TA_CENTER,
        textColor=ink_color
    ))

    styles.add(ParagraphStyle(
        name="RetroCoverEpisode",
        parent=styles["Normal"],
        fontName=font_bold,
        fontSize=15,
        leading=20,
        alignment=TA_CENTER,
        textColor=ink_color
    ))

    styles.add(ParagraphStyle(
        name="RetroPageTitle",
        parent=styles["Normal"],
        fontName=font_bold,
        fontSize=14,
        leading=18,
        textColor=ink_color,
        spaceAfter=1 * mm
    ))

    styles.add(ParagraphStyle(
        name="RetroSection",
        parent=styles["Normal"],
        fontName=font_bold,
        fontSize=10.5,
        leading=13,
        textColor=paper_color
    ))

    styles.add(ParagraphStyle(
        name="RetroText",
        parent=styles["BodyText"],
        fontName=font_regular,
        fontSize=9,
        leading=12.5,
        textColor=ink_color,
        spaceAfter=1.5 * mm
    ))

    styles.add(ParagraphStyle(
        name="RetroEntryName",
        parent=styles["BodyText"],
        fontName=font_bold,
        fontSize=9.5,
        leading=12.5,
        textColor=ink_color,
        spaceAfter=0.8 * mm
    ))

    styles.add(ParagraphStyle(
        name="RetroSmall",
        parent=styles["BodyText"],
        fontName=font_regular,
        fontSize=8.5,
        leading=11.5,
        textColor=ink_color,
        spaceAfter=0.6 * mm
    ))

    styles.add(ParagraphStyle(
        name="RetroEmpty",
        parent=styles["BodyText"],
        fontName=font_regular,
        fontSize=8.5,
        leading=11,
        textColor=faded_ink,
        spaceAfter=1 * mm
    ))

    styles.add(ParagraphStyle(
        name="RetroFormLabel",
        parent=styles["BodyText"],
        fontName=font_bold,
        fontSize=8,
        leading=10.5,
        textColor=faded_ink
    ))

    styles.add(ParagraphStyle(
        name="RetroFormValue",
        parent=styles["BodyText"],
        fontName=font_regular,
        fontSize=10,
        leading=13,
        textColor=ink_color
    ))

    def safe(value):
        if value is None or str(value).strip() == "":
            return "?"

        return escape(str(value)).replace("\n", "<br/>")

    def label_text(label):
        return f'<font name="{font_bold}">{escape(label)}:</font>'

    # --------------------------------------------------------
    # Hilfselemente
    # --------------------------------------------------------
    class CaseMarker(Flowable):
        """Merkt sich das aktuelle Aktenzeichen für Kopf- und Fußzeilen."""

        def __init__(self, case_number):
            super().__init__()
            self.case_number = case_number

        def wrap(self, available_width, available_height):
            return 0, 0

        def draw(self):
            document.current_case = self.case_number

    def section_bar(title):
        bar = Table(
            [[Paragraph(escape(title), styles["RetroSection"])]],
            colWidths=[document.width]
        )

        bar.setStyle(TableStyle([
            ("BACKGROUND", (0, 0), (-1, -1), ink_color),
            ("LEFTPADDING", (0, 0), (-1, -1), 6),
            ("RIGHTPADDING", (0, 0), (-1, -1), 6),
            ("TOPPADDING", (0, 0), (-1, -1), 3),
            ("BOTTOMPADDING", (0, 0), (-1, -1), 4)
        ]))

        return bar

    def add_field(story, label, value):
        if value is None or str(value).strip() == "":
            return

        story.append(Paragraph(
            f"{label_text(label)} {safe(value)}",
            styles["RetroText"]
        ))

    def add_section(story, title, entries, fields):
        heading = [Spacer(1, 6 * mm), section_bar(title), Spacer(1, 2.5 * mm)]

        if not entries:
            story.append(KeepTogether(heading + [Paragraph(
                "– Keine Einträge vorhanden –",
                styles["RetroEmpty"]
            )]))
            return

        first = True

        for entry in entries:
            name = (
                entry.get("name")
                or entry.get("title")
                or entry.get("speaker_name")
                or "Ohne Bezeichnung"
            )

            content = [Paragraph(safe(name).upper(), styles["RetroEntryName"])]

            for field, label in fields:
                value = entry.get(field)

                if value is not None and str(value).strip():
                    content.append(Paragraph(
                        f"{label_text(label)} {safe(value)}",
                        styles["RetroSmall"]
                    ))

            card = Table([[content]], colWidths=[document.width])

            card.setStyle(TableStyle([
                ("LINEBEFORE", (0, 0), (0, -1), 2, rule_color),
                ("LINEBELOW", (0, 0), (-1, -1), 0.4, rule_color, None, (2, 2)),
                ("LEFTPADDING", (0, 0), (-1, -1), 8),
                ("RIGHTPADDING", (0, 0), (-1, -1), 4),
                ("TOPPADDING", (0, 0), (-1, -1), 3),
                ("BOTTOMPADDING", (0, 0), (-1, -1), 5)
            ]))

            if first:
                story.append(KeepTogether(heading + [card]))
                first = False
            else:
                story.append(card)

            story.append(Spacer(1, 2 * mm))

    # --------------------------------------------------------
    # Seitenhintergründe
    # --------------------------------------------------------
    def draw_punch_holes(canvas):
        canvas.setFillColor(colors.HexColor("#FBF8F1"))
        canvas.setStrokeColor(rule_color)
        canvas.setLineWidth(0.6)

        for offset in (-40 * mm, 40 * mm):
            canvas.circle(9 * mm, page_height / 2 + offset, 2.8 * mm,
                          stroke=1, fill=1)

    def draw_stamp(canvas, text, x, y, angle, size):
        canvas.saveState()
        canvas.translate(x, y)
        canvas.rotate(angle)

        canvas.setFont(font_bold, size)
        text_width = pdfmetrics.stringWidth(text, font_bold, size)
        box_width = text_width + size * 1.4
        box_height = size * 1.9

        canvas.setStrokeColor(stamp_red)
        canvas.setFillColor(stamp_red)
        canvas.setStrokeAlpha(0.82)
        canvas.setFillAlpha(0.82)

        canvas.setLineWidth(2.2)
        canvas.roundRect(-box_width / 2, -box_height / 2,
                         box_width, box_height, 3, stroke=1, fill=0)
        canvas.setLineWidth(0.8)
        canvas.roundRect(-box_width / 2 + 3, -box_height / 2 + 3,
                         box_width - 6, box_height - 6, 2, stroke=1, fill=0)

        canvas.drawCentredString(0, -size * 0.35, text)
        canvas.restoreState()

    def draw_cover(canvas, doc):
        canvas.saveState()

        # Aktendeckel
        canvas.setFillColor(folder_color)
        canvas.rect(0, 0, page_width, page_height, stroke=0, fill=1)

        # Reiter oben rechts
        canvas.setFillColor(folder_dark)
        tab = canvas.beginPath()
        tab.moveTo(page_width - 95 * mm, page_height)
        tab.lineTo(page_width - 90 * mm, page_height - 12 * mm)
        tab.lineTo(page_width - 22 * mm, page_height - 12 * mm)
        tab.lineTo(page_width - 17 * mm, page_height)
        tab.close()
        canvas.drawPath(tab, stroke=0, fill=1)

        canvas.setFont(font_bold, 11)
        canvas.setFillColor(ink_color)
        canvas.drawCentredString(
            page_width - 56 * mm,
            page_height - 8 * mm,
            f"AZ {getattr(doc, 'next_case', '')}"
        )

        # Doppelter Rahmen
        canvas.setStrokeColor(ink_color)
        canvas.setLineWidth(1.4)
        canvas.rect(16 * mm, 16 * mm,
                    page_width - 32 * mm, page_height - 36 * mm)
        canvas.setLineWidth(0.5)
        canvas.rect(18 * mm, 18 * mm,
                    page_width - 36 * mm, page_height - 40 * mm)

        draw_punch_holes(canvas)

        # Stempel
        draw_stamp(canvas, "VERTRAULICH",
                   page_width - 62 * mm, 52 * mm, 14, 20)

        canvas.setFont(font_regular, 7.5)
        canvas.setFillColor(faded_ink)
        canvas.drawCentredString(
            page_width / 2, 11 * mm,
            "Nur für den Dienstgebrauch · Weitergabe an Unbefugte untersagt"
        )

        canvas.restoreState()

    def draw_content_page(canvas, doc):
        canvas.saveState()

        canvas.setFillColor(paper_color)
        canvas.rect(0, 0, page_width, page_height, stroke=0, fill=1)

        draw_punch_holes(canvas)

        case_number = getattr(doc, "current_case", "")

        # Kopfzeile
        canvas.setFont(font_bold, 8.5)
        canvas.setFillColor(ink_color)
        canvas.drawString(22 * mm, page_height - 13 * mm,
                          "ERMITTLUNGSAKTE")
        canvas.setFont(font_regular, 8.5)
        canvas.drawString(22 * mm + pdfmetrics.stringWidth(
            "ERMITTLUNGSAKTE  ", font_bold, 8.5),
            page_height - 13 * mm, f"AZ {case_number}")

        canvas.setFillColor(stamp_red)
        canvas.setFont(font_bold, 8.5)
        canvas.drawRightString(page_width - 18 * mm,
                               page_height - 13 * mm, "VERTRAULICH")

        canvas.setStrokeColor(ink_color)
        canvas.setLineWidth(0.8)
        canvas.line(22 * mm, page_height - 15.5 * mm,
                    page_width - 18 * mm, page_height - 15.5 * mm)
        canvas.setLineWidth(0.3)
        canvas.line(22 * mm, page_height - 16.5 * mm,
                    page_width - 18 * mm, page_height - 16.5 * mm)

        # Fußzeile
        canvas.setStrokeColor(rule_color)
        canvas.setLineWidth(0.5)
        canvas.line(22 * mm, 15 * mm, page_width - 18 * mm, 15 * mm)

        canvas.setFont(font_regular, 7.5)
        canvas.setFillColor(faded_ink)
        canvas.drawString(22 * mm, 10 * mm,
                          "DIE DREI ??? – INTERNES ARCHIVSYSTEM")
        canvas.drawRightString(page_width - 18 * mm, 10 * mm,
                               f"Blatt {doc.page}")

        canvas.restoreState()

    # --------------------------------------------------------
    # Dokument mit zwei Seitenvorlagen (Deckblatt / Inhalt)
    # --------------------------------------------------------
    document = BaseDocTemplate(
        str(output_path),
        pagesize=A4,
        rightMargin=18 * mm,
        leftMargin=22 * mm,
        topMargin=22 * mm,
        bottomMargin=22 * mm,
        title="Die drei ??? – Fallakten",
        author="Die drei ??? – Archivverwaltung"
    )

    document.current_case = ""
    document.next_case = ""

    cover_frame = Frame(
        24 * mm, 24 * mm,
        page_width - 48 * mm, page_height - 52 * mm,
        id="cover"
    )

    content_frame = Frame(
        document.leftMargin, document.bottomMargin,
        document.width, document.height,
        id="content"
    )

    def before_cover(canvas, doc):
        doc.next_case = doc.case_queue.pop(0) if doc.case_queue else ""

    document.addPageTemplates([
        PageTemplate(id="Cover", frames=[cover_frame],
                     onPage=lambda c, d: (before_cover(c, d), draw_cover(c, d))),
        PageTemplate(id="Content", frames=[content_frame],
                     onPage=draw_content_page)
    ])

    document.case_queue = []

    story = []

    for index, current_id in enumerate(episode_ids):
        data = get_episode_casefile(current_id)
        episode = data["episode"]

        number = episode.get("episode_number", "?")
        title = episode.get("title", "Ohne Titel")
        case_number = f"DFD-{number}"

        document.case_queue.append(case_number)

        # ---------------- Deckblatt ----------------
        story.append(CaseMarker(case_number))
        story.append(Spacer(1, 10 * mm))

        story.append(Paragraph(
            "POLIZEIREVIER ROCKY BEACH",
            styles["RetroAuthority"]
        ))

        story.append(Paragraph(
            "Kriminalabteilung · Aktenarchiv",
            styles["RetroAuthoritySmall"]
        ))

        story.append(Spacer(1, 22 * mm))

        story.append(Paragraph("ERMITTLUNGSAKTE", styles["RetroCoverTitle"]))

        story.append(Paragraph(
            f"FALLAKTE NR. {safe(number)}",
            styles["RetroCoverCase"]
        ))

        story.append(Spacer(1, 12 * mm))

        title_box = Table(
            [[Paragraph(f"»{safe(title)}«", styles["RetroCoverEpisode"])]],
            colWidths=[130 * mm]
        )

        title_box.setStyle(TableStyle([
            ("BOX", (0, 0), (-1, -1), 1.2, ink_color),
            ("BACKGROUND", (0, 0), (-1, -1), paper_color),
            ("TOPPADDING", (0, 0), (-1, -1), 9),
            ("BOTTOMPADDING", (0, 0), (-1, -1), 11),
            ("LEFTPADDING", (0, 0), (-1, -1), 10),
            ("RIGHTPADDING", (0, 0), (-1, -1), 10)
        ]))

        story.append(title_box)
        story.append(Spacer(1, 14 * mm))

        cover_data = [
            ["AKTENZEICHEN", case_number],
            ["FOLGENNUMMER", str(number)],
            ["ORIGINALTITEL", str(title)],
            ["VERÖFFENTLICHUNG", str(episode.get("release_date") or "?")],
            ["LAUFZEIT", (
                f"{episode['runtime_minutes']} Minuten"
                if episode.get("runtime_minutes") else "?"
            )],
            ["ERMITTLER", "Die drei ???"]
        ]

        form = Table(
            [
                [
                    Paragraph(escape(label), styles["RetroFormLabel"]),
                    Paragraph(safe(value), styles["RetroFormValue"])
                ]
                for label, value in cover_data
            ],
            colWidths=[44 * mm, 100 * mm]
        )

        form.setStyle(TableStyle([
            ("BACKGROUND", (0, 0), (0, -1), label_color),
            ("BACKGROUND", (1, 0), (1, -1), paper_color),
            ("BOX", (0, 0), (-1, -1), 1, ink_color),
            ("INNERGRID", (0, 0), (-1, -1), 0.4, rule_color),
            ("VALIGN", (0, 0), (-1, -1), "MIDDLE"),
            ("LEFTPADDING", (0, 0), (-1, -1), 7),
            ("RIGHTPADDING", (0, 0), (-1, -1), 7),
            ("TOPPADDING", (0, 0), (-1, -1), 5),
            ("BOTTOMPADDING", (0, 0), (-1, -1), 6)
        ]))

        story.append(form)

        story.append(NextPageTemplate("Content"))
        story.append(PageBreak())

        # ---------------- Inhaltsseiten ----------------
        story.append(Paragraph(
            f"FALLAKTE {safe(number)} – {safe(title).upper()}",
            styles["RetroPageTitle"]
        ))

        story.append(KeepTogether([
            Spacer(1, 3 * mm),
            section_bar("1. FALLBESCHREIBUNG"),
            Spacer(1, 2.5 * mm)
        ]))

        add_field(story, "Folgenummer", number)
        add_field(story, "Originaltitel", title)
        add_field(story, "Veröffentlichung", episode.get("release_date"))

        if episode.get("runtime_minutes"):
            add_field(
                story,
                "Laufzeit",
                f"{episode['runtime_minutes']} Minuten"
            )

        add_field(story, "Zusammenfassung", episode.get("synopsis"))
        add_field(story, "Interne Notizen", episode.get("notes"))

        # Verknüpfte Archivbestände
        add_section(
            story,
            "2. FIGUREN",
            data.get("persons", []),
            [
                ("role", "Rolle"),
                ("aliases", "Weitere Namen"),
                ("description", "Beschreibung"),
                ("notes", "Fallbezogene Notizen")
            ]
        )

        add_section(
            story,
            "3. SPRECHER",
            data.get("speakers", []),
            [
                ("speaker_name", "Sprecher"),
                ("person_name", "Dargestellte Figur"),
                ("biography", "Biografie"),
                ("aliases", "Weitere Namen"),
                ("speaker_notes", "Sprecher-Notizen"),
                ("role_notes", "Rollen-Notizen")
            ]
        )

        add_section(
            story,
            "4. SCHAUPLÄTZE",
            data.get("places", []),
            [
                ("description", "Beschreibung"),
                ("notes", "Fallbezogene Notizen")
            ]
        )

        add_section(
            story,
            "5. GEGENSTÄNDE",
            data.get("objects", []),
            [
                ("description", "Beschreibung"),
                ("notes", "Fallbezogene Notizen")
            ]
        )

        add_section(
            story,
            "6. KREATUREN UND MONSTER",
            data.get("creatures", []),
            [
                ("description", "Beschreibung"),
                ("notes", "Fallbezogene Notizen")
            ]
        )

        add_section(
            story,
            "7. ORGANISATIONEN",
            data.get("organizations", []),
            [
                ("description", "Beschreibung"),
                ("notes", "Fallbezogene Notizen")
            ]
        )

        add_section(
            story,
            "8. SCHLAGWÖRTER",
            data.get("keywords", []),
            []
        )

        add_section(
            story,
            "9. QUELLEN UND BELEGE",
            data.get("sources", []),
            [
                ("source_type", "Quellentyp"),
                ("author", "Autor"),
                ("publication_date", "Erscheinungsdatum"),
                ("url", "Internetadresse"),
                ("notes", "Quellen-Notizen"),
                ("assignment_notes", "Fallbezogene Quellen-Notizen")
            ]
        )

        if index < len(episode_ids) - 1:
            story.append(NextPageTemplate("Cover"))
            story.append(PageBreak())

    document.build(story)

    return str(output_path)
