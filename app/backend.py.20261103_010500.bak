@app.get("/api/sources")
def get_sources(
    search: str = "",
    source_type: str = "",
    verification_status: str = "",
    reliability: str = ""
):
    conditions = []
    parameters = []

    if search.strip():
        conditions.append(
            "(title LIKE ? OR author LIKE ? OR source_type LIKE ?)"
        )
        search_value = f"%{search.strip()}%"
        parameters.extend([search_value, search_value, search_value])

    if source_type:
        conditions.append("source_type = ?")
        parameters.append(source_type)

    if verification_status:
        conditions.append("verification_status = ?")
        parameters.append(verification_status)

    if reliability:
        conditions.append("reliability = ?")
        parameters.append(reliability)

    query = """
        SELECT id, title, source_type, author,
               publication_date, url, notes,
               verification_status, reliability
        FROM sources
    """

    if conditions:
        query += " WHERE " + " AND ".join(conditions)

    query += " ORDER BY title COLLATE NOCASE"

    with get_connection() as conn:
        rows = conn.execute(query, parameters).fetchall()

    return [dict(row) for row in rows]


