@app.get("/api/organizations")
def list_organizations(search: str = ""):
    with get_connection() as conn:
        if search.strip():
            rows = conn.execute(
                """
                SELECT *
                FROM organizations
                WHERE name LIKE ? OR description LIKE ?
                ORDER BY name COLLATE NOCASE
                """,
                (
                    f"%{search.strip()}%",
                    f"%{search.strip()}%"
                )
            ).fetchall()
        else:
            rows = conn.execute(
                """
                SELECT *
                FROM organizations
                ORDER BY name COLLATE NOCASE
                """
            ).fetchall()

        return [dict(row) for row in rows]


