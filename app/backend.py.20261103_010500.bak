# ============================================================
# DATENBANKVERBINDUNG
# ============================================================

def get_connection():
    if not DB_PATH.exists():
        raise FileNotFoundError(
            f"Datenbank nicht gefunden: {DB_PATH}"
        )

    connection = sqlite3.connect(DB_PATH)
    connection.row_factory = sqlite3.Row
    connection.execute("PRAGMA foreign_keys = ON")

    return connection


# ============================================================
# DATENMODELLE
# ============================================================

class Episode(BaseModel):
    episode_number: int
    title: str
    release_date: Optional[str] = None
    runtime_minutes: Optional[int] = None
    synopsis: Optional[str] = None
    notes: Optional[str] = None


class Person(BaseModel):
    name: str
    description: Optional[str] = None
    aliases: list[str] = Field(default_factory=list)


class PersonEpisodeAssignment(BaseModel):
    episode_id: int
    role: Optional[str] = None
    notes: Optional[str] = None


class Speaker(BaseModel):
    name: str
    birth_date: Optional[str] = None
    death_date: Optional[str] = None
    biography: Optional[str] = None
    notes: Optional[str] = None
    aliases: list[str] = Field(default_factory=list)


class SpeakerRole(BaseModel):
    person_id: int
    episode_id: int
    role_notes: Optional[str] = None


class Place(BaseModel):
    name: str
    description: Optional[str] = None


class PlaceEpisodeAssignment(BaseModel):
    episode_id: int
    notes: Optional[str] = None


class ArchiveObject(BaseModel):
    name: str
    description: Optional[str] = None


class ObjectEpisodeAssignment(BaseModel):
    episode_id: int
    notes: Optional[str] = None


class Creature(BaseModel):
    name: str
    description: Optional[str] = None


class CreatureEpisodeAssignment(BaseModel):
    episode_id: int
    notes: Optional[str] = None


class Organization(BaseModel):
    name: str
    description: Optional[str] = None


class OrganizationEpisodeAssignment(BaseModel):
    episode_id: int
    notes: Optional[str] = None


class Keyword(BaseModel):
    name: str


class KeywordEpisodeAssignment(BaseModel):
    episode_id: int


class Source(BaseModel):
    title: str
    source_type: Optional[str] = None
    author: Optional[str] = None
    publication_date: Optional[str] = None
    url: Optional[str] = None
    notes: Optional[str] = None
    verification_status: str = "Ungeprüft"
    reliability: str = "Nicht einschätzbar"


class SourceEpisodeAssignment(BaseModel):
    episode_id: int
    notes: Optional[str] = None


class SourceEpisodeNotes(BaseModel):
    notes: Optional[str] = None


# ============================================================
# STATUS UND DATENBANKTEST
# ============================================================

@app.get("/api/status")
def database_status():
    try:
        with get_connection() as connection:
            count = connection.execute(
                "SELECT COUNT(*) FROM episodes"
            ).fetchone()[0]

        return {
            "database": "connected",
            "episode_count": count
        }

    except Exception as error:
        raise HTTPException(
            status_code=500,
            detail=str(error)
        )


# ============================================================
# HÖRSPIELFOLGEN – API
# ============================================================

@app.get("/api/episodes")
def list_episodes(search: str = ""):
    try:
        with get_connection() as connection:
            if search.strip():
                episodes = connection.execute(
                    """
                    SELECT id, episode_number, title,
                           release_date, runtime_minutes
                    FROM episodes
                    WHERE CAST(episode_number AS TEXT) = ?
                       OR title LIKE ?
                    ORDER BY episode_number
                    """,
                    (search.strip(), f"%{search.strip()}%")
                ).fetchall()
            else:
                episodes = connection.execute(
                    """
                    SELECT id, episode_number, title,
                           release_date, runtime_minutes
                    FROM episodes
                    ORDER BY episode_number
                    """
                ).fetchall()

        return [dict(episode) for episode in episodes]

    except Exception as error:
        raise HTTPException(
            status_code=500,
            detail=str(error)
        )


@app.post("/api/episodes")
def create_episode(episode: Episode):
    try:
        with get_connection() as connection:
            cursor = connection.execute(
                """
                INSERT INTO episodes (
                    episode_number,
                    title,
                    release_date,
                    runtime_minutes,
                    synopsis,
                    notes
                )
                VALUES (?, ?, ?, ?, ?, ?)
                """,
                (
                    episode.episode_number,
                    episode.title,
                    episode.release_date,
                    episode.runtime_minutes,
                    episode.synopsis,
                    episode.notes
                )
            )

            new_id = cursor.lastrowid

        return {
            "success": True,
            "id": new_id,
            "message": "Hörspielfolge wurde angelegt."
        }

    except sqlite3.IntegrityError as error:
        raise HTTPException(
            status_code=409,
            detail=f"Datensatz konnte nicht angelegt werden: {error}"
        )

    except Exception as error:
        raise HTTPException(
            status_code=500,
            detail=str(error)
        )


@app.get("/api/episodes/{episode_id}")
def get_episode(episode_id: int):
    try:
        with get_connection() as connection:
            episode = connection.execute(
                """
                SELECT *
                FROM episodes
                WHERE id = ?
                """,
                (episode_id,)
            ).fetchone()

        if episode is None:
            raise HTTPException(
                status_code=404,
                detail="Hörspielfolge nicht gefunden."
            )

        return dict(episode)

    except HTTPException:
        raise

    except Exception as error:
        raise HTTPException(
            status_code=500,
            detail=str(error)
        )



@app.get("/api/episodes/{episode_id}/casefile")
def get_episode_casefile(episode_id: int):
    try:
        with get_connection() as connection:
            episode = connection.execute(
                "SELECT * FROM episodes WHERE id = ?",
                (episode_id,)
            ).fetchone()

            if episode is None:
                raise HTTPException(
                    status_code=404,
                    detail="Hörspielfolge nicht gefunden."
                )

            persons = connection.execute(
                """
                SELECT
                    p.id,
                    p.name,
                    p.description,
                    ep.role,
                    ep.notes,
                    (
                        SELECT GROUP_CONCAT(pa.alias, ', ')
                        FROM person_aliases pa
                        WHERE pa.person_id = p.id
                    ) AS aliases
                FROM episode_persons ep
                JOIN persons p ON p.id = ep.person_id
                WHERE ep.episode_id = ?
                ORDER BY p.name
                """,
                (episode_id,)
            ).fetchall()

            speakers = connection.execute(
                """
                SELECT
                    s.id AS speaker_id,
                    s.name AS speaker_name,
                    s.biography,
                    s.notes AS speaker_notes,
                    p.id AS person_id,
                    p.name AS person_name,
                    sr.role_notes,
                    (
                        SELECT GROUP_CONCAT(sa.alias, ', ')
                        FROM speaker_aliases sa
                        WHERE sa.speaker_id = s.id
                    ) AS aliases
                FROM speaker_roles sr
                JOIN speakers s ON s.id = sr.speaker_id
                JOIN persons p ON p.id = sr.person_id
                WHERE sr.episode_id = ?
                ORDER BY s.name, p.name
                """,
                (episode_id,)
            ).fetchall()

            places = connection.execute(
                """
                SELECT p.id, p.name, p.description, ep.notes
                FROM episode_places ep
                JOIN places p ON p.id = ep.place_id
                WHERE ep.episode_id = ?
                ORDER BY p.name
                """,
                (episode_id,)
            ).fetchall()

            objects = connection.execute(
                """
                SELECT o.id, o.name, o.description, eo.notes
                FROM episode_objects eo
                JOIN objects o ON o.id = eo.object_id
                WHERE eo.episode_id = ?
                ORDER BY o.name
                """,
                (episode_id,)
            ).fetchall()

            creatures = connection.execute(
                """
                SELECT c.id, c.name, c.description, ec.notes
                FROM episode_creatures ec
                JOIN creatures c ON c.id = ec.creature_id
                WHERE ec.episode_id = ?
                ORDER BY c.name
                """,
                (episode_id,)
            ).fetchall()

            organizations = connection.execute(
                """
                SELECT o.id, o.name, o.description, eo.notes
                FROM episode_organizations eo
                JOIN organizations o
                    ON o.id = eo.organization_id
                WHERE eo.episode_id = ?
                ORDER BY o.name
                """,
                (episode_id,)
            ).fetchall()

            keywords = connection.execute(
                """
                SELECT k.id, k.name
                FROM episode_keywords ek
                JOIN keywords k ON k.id = ek.keyword_id
                WHERE ek.episode_id = ?
                ORDER BY k.name
                """,
                (episode_id,)
            ).fetchall()

            sources = connection.execute(
                """
                SELECT
                    s.id,
                    s.title,
                    s.source_type,
                    s.author,
                    s.publication_date,
                    s.url,
                    s.notes,
                    es.notes AS assignment_notes
                FROM episode_sources es
                JOIN sources s ON s.id = es.source_id
                WHERE es.episode_id = ?
                ORDER BY s.title
                """,
                (episode_id,)
            ).fetchall()

        return {
            "episode": dict(episode),
            "persons": [dict(row) for row in persons],
            "speakers": [dict(row) for row in speakers],
            "places": [dict(row) for row in places],
            "objects": [dict(row) for row in objects],
            "creatures": [dict(row) for row in creatures],
            "organizations": [dict(row) for row in organizations],
            "keywords": [dict(row) for row in keywords],
            "sources": [dict(row) for row in sources]
        }

    except HTTPException:
        raise

    except Exception as error:
        raise HTTPException(
            status_code=500,
            detail=str(error)
        )

@app.put("/api/episodes/{episode_id}")
def update_episode(episode_id: int, episode: Episode):
    try:
        with get_connection() as connection:
            cursor = connection.execute(
                """
                UPDATE episodes
                SET episode_number = ?,
                    title = ?,
                    release_date = ?,
                    runtime_minutes = ?,
                    synopsis = ?,
                    notes = ?
                WHERE id = ?
                """,
                (
                    episode.episode_number,
                    episode.title,
                    episode.release_date,
                    episode.runtime_minutes,
                    episode.synopsis,
                    episode.notes,
                    episode_id
                )
            )

            if cursor.rowcount == 0:
                raise HTTPException(
                    status_code=404,
                    detail="Hörspielfolge nicht gefunden."
                )

        return {
            "success": True,
            "message": "Hörspielfolge wurde aktualisiert."
        }

    except HTTPException:
        raise

    except sqlite3.IntegrityError as error:
        raise HTTPException(
            status_code=409,
            detail=f"Änderung nicht möglich: {error}"
        )

    except Exception as error:
        raise HTTPException(
            status_code=500,
            detail=str(error)
        )


@app.delete("/api/episodes/{episode_id}")
def delete_episode(episode_id: int):
    try:
        with get_connection() as conn:
            existing = conn.execute(
                "SELECT id FROM episodes WHERE id = ?",
                (episode_id,)
            ).fetchone()

            if existing is None:
                raise HTTPException(
                    status_code=404,
                    detail="Hörspielfolge nicht gefunden."
                )

            conn.execute(
                "DELETE FROM speaker_roles WHERE episode_id = ?",
                (episode_id,)
            )

            conn.execute(
                "DELETE FROM episodes WHERE id = ?",
                (episode_id,)
            )

            return {
                "success": True,
                "message": "Hörspielfolge und ihre Verknüpfungen wurden gelöscht."
            }

    except sqlite3.IntegrityError:
        raise HTTPException(
            status_code=409,
            detail="Die Hörspielfolge konnte aufgrund weiterer Verknüpfungen nicht gelöscht werden."
        )


# ============================================================
# FIGURENVERWALTUNG – API
# ============================================================

@app.get("/api/persons")
def list_persons(search: str = ""):
    with get_connection() as conn:
        if search.strip():
            persons = conn.execute(
                """
                SELECT DISTINCT p.*
                FROM persons p
                LEFT JOIN person_aliases a ON a.person_id = p.id
                WHERE p.name LIKE ?
                   OR p.description LIKE ?
                   OR a.alias LIKE ?
                ORDER BY p.name COLLATE NOCASE
                """,
                (
                    f"%{search}%",
                    f"%{search}%",
                    f"%{search}%"
                )
            ).fetchall()
        else:
            persons = conn.execute(
                """
                SELECT *
                FROM persons
                ORDER BY name COLLATE NOCASE
                """
            ).fetchall()

        result = []

        for person in persons:
            aliases = conn.execute(
                """
                SELECT alias
                FROM person_aliases
                WHERE person_id = ?
                ORDER BY alias COLLATE NOCASE
                """,
                (person["id"],)
            ).fetchall()

            result.append({
                "id": person["id"],
                "name": person["name"],
                "description": person["description"],
                "aliases": [a["alias"] for a in aliases]
            })

        return result


@app.post("/api/persons")
def create_person(person: Person):
    name = person.name.strip()

    if not name:
        raise HTTPException(
            status_code=400,
            detail="Der Figurenname darf nicht leer sein."
        )

    aliases = list(dict.fromkeys(
        alias.strip()
        for alias in person.aliases
        if alias.strip() and alias.strip() != name
    ))

    try:
        with get_connection() as conn:
            cursor = conn.execute(
                """
                INSERT INTO persons (name, description)
                VALUES (?, ?)
                """,
                (name, person.description)
            )

            person_id = cursor.lastrowid

            for alias in aliases:
                conn.execute(
                    """
                    INSERT INTO person_aliases (person_id, alias)
                    VALUES (?, ?)
                    """,
                    (person_id, alias)
                )

            return {
                "id": person_id,
                "message": "Figur erfolgreich angelegt."
            }

    except sqlite3.IntegrityError:
        raise HTTPException(
            status_code=409,
            detail="Die Figur konnte nicht angelegt werden."
        )


@app.get("/api/persons/{person_id}")
def get_person(person_id: int):
    with get_connection() as conn:
        person = conn.execute(
            "SELECT * FROM persons WHERE id = ?",
            (person_id,)
        ).fetchone()

        if person is None:
            raise HTTPException(
                status_code=404,
                detail="Figur nicht gefunden."
            )

        aliases = conn.execute(
            """
            SELECT alias
            FROM person_aliases
            WHERE person_id = ?
            ORDER BY alias COLLATE NOCASE
            """,
            (person_id,)
        ).fetchall()

        return {
            "id": person["id"],
            "name": person["name"],
            "description": person["description"],
            "aliases": [a["alias"] for a in aliases]
        }


@app.put("/api/persons/{person_id}")
def update_person(person_id: int, person: Person):
    name = person.name.strip()

    if not name:
        raise HTTPException(
            status_code=400,
            detail="Der Figurenname darf nicht leer sein."
        )

    aliases = list(dict.fromkeys(
        alias.strip()
        for alias in person.aliases
        if alias.strip() and alias.strip() != name
    ))

    try:
        with get_connection() as conn:
            existing = conn.execute(
                "SELECT id FROM persons WHERE id = ?",
                (person_id,)
            ).fetchone()

            if existing is None:
                raise HTTPException(
                    status_code=404,
                    detail="Figur nicht gefunden."
                )

            conn.execute(
                """
                UPDATE persons
                SET name = ?, description = ?
                WHERE id = ?
                """,
                (name, person.description, person_id)
            )

            conn.execute(
                "DELETE FROM person_aliases WHERE person_id = ?",
                (person_id,)
            )

            for alias in aliases:
                conn.execute(
                    """
                    INSERT INTO person_aliases (person_id, alias)
                    VALUES (?, ?)
                    """,
                    (person_id, alias)
                )

            return {
                "message": "Figur erfolgreich aktualisiert."
            }

    except sqlite3.IntegrityError:
        raise HTTPException(
            status_code=409,
            detail="Die Figur konnte nicht aktualisiert werden."
        )


@app.delete("/api/persons/{person_id}")
def delete_person(person_id: int):
    try:
        with get_connection() as conn:
            existing = conn.execute(
                "SELECT id FROM persons WHERE id = ?",
                (person_id,)
            ).fetchone()

            if existing is None:
                raise HTTPException(
                    status_code=404,
                    detail="Figur nicht gefunden."
                )

            conn.execute(
                "DELETE FROM speaker_roles WHERE person_id = ?",
                (person_id,)
            )

            conn.execute(
                "DELETE FROM persons WHERE id = ?",
                (person_id,)
            )

            return {
                "message": "Figur und ihre Verknüpfungen erfolgreich gelöscht."
            }

    except sqlite3.IntegrityError:
        raise HTTPException(
            status_code=409,
            detail="Die Figur kann aufgrund weiterer Verknüpfungen nicht gelöscht werden."
        )


# ============================================================
# FIGUREN UND HÖRSPIELFOLGEN – ZUORDNUNGEN
# ============================================================

@app.get("/api/persons/{person_id}/episodes")
def get_person_episodes(person_id: int):
    with get_connection() as conn:
        person = conn.execute(
            "SELECT id FROM persons WHERE id = ?",
            (person_id,)
        ).fetchone()

        if not person:
            raise HTTPException(
                status_code=404,
                detail="Figur nicht gefunden."
            )

        rows = conn.execute(
            """
            SELECT
                e.id AS episode_id,
                e.episode_number,
                e.title,
                ep.role,
                ep.notes
            FROM episode_persons ep
            JOIN episodes e ON e.id = ep.episode_id
            WHERE ep.person_id = ?
            ORDER BY e.episode_number
            """,
            (person_id,)
        ).fetchall()

        return [dict(row) for row in rows]


@app.post("/api/persons/{person_id}/episodes")
def assign_person_to_episode(
    person_id: int,
    assignment: PersonEpisodeAssignment
):
    with get_connection() as conn:
        if not conn.execute(
            "SELECT id FROM persons WHERE id = ?",
            (person_id,)
        ).fetchone():
            raise HTTPException(
                status_code=404,
                detail="Figur nicht gefunden."
            )

        if not conn.execute(
            "SELECT id FROM episodes WHERE id = ?",
            (assignment.episode_id,)
        ).fetchone():
            raise HTTPException(
                status_code=404,
                detail="Hörspielfolge nicht gefunden."
            )

        try:
            conn.execute(
                """
                INSERT INTO episode_persons
                (episode_id, person_id, role, notes)
                VALUES (?, ?, ?, ?)
                """,
                (
                    assignment.episode_id,
                    person_id,
                    assignment.role,
                    assignment.notes
                )
            )

            conn.commit()

        except sqlite3.IntegrityError:
            raise HTTPException(
                status_code=409,
                detail="Diese Figur ist dieser Folge bereits zugeordnet."
            )

        return {
            "message": "Figur wurde der Hörspielfolge zugeordnet."
        }


@app.put("/api/persons/{person_id}/episodes/{episode_id}")
def update_person_episode(
    person_id: int,
    episode_id: int,
    assignment: PersonEpisodeAssignment
):
    if assignment.episode_id != episode_id:
        raise HTTPException(
            status_code=400,
            detail="Die Folgen-ID stimmt nicht überein."
        )

    with get_connection() as conn:
        cursor = conn.execute(
            """
            UPDATE episode_persons
            SET role = ?, notes = ?
            WHERE person_id = ? AND episode_id = ?
            """,
            (
                assignment.role,
                assignment.notes,
                person_id,
                episode_id
            )
        )

        conn.commit()

        if cursor.rowcount == 0:
            raise HTTPException(
                status_code=404,
                detail="Zuordnung nicht gefunden."
            )

        return {
            "message": "Zuordnung wurde aktualisiert."
        }


@app.delete("/api/persons/{person_id}/episodes/{episode_id}")
def remove_person_episode(person_id: int, episode_id: int):
    with get_connection() as conn:
        cursor = conn.execute(
            """
            DELETE FROM episode_persons
            WHERE person_id = ? AND episode_id = ?
            """,
            (person_id, episode_id)
        )

        conn.commit()

        if cursor.rowcount == 0:
            raise HTTPException(
                status_code=404,
                detail="Zuordnung nicht gefunden."
            )

        return {
            "message": "Zuordnung wurde entfernt."
        }


# ============================================================
# SPRECHERVERWALTUNG – API
# ============================================================

@app.get("/api/speakers")
def list_speakers(search: str = ""):
    with get_connection() as conn:
        rows = conn.execute(
            """
            SELECT DISTINCT s.*
            FROM speakers s
            LEFT JOIN speaker_aliases sa ON sa.speaker_id = s.id
            WHERE s.name LIKE ?
               OR s.biography LIKE ?
               OR sa.alias LIKE ?
            ORDER BY s.name COLLATE NOCASE
            """,
            (
                f"%{search}%",
                f"%{search}%",
                f"%{search}%"
            )
        ).fetchall()

        result = []

        for row in rows:
            speaker = dict(row)

            aliases = conn.execute(
                """
                SELECT alias
                FROM speaker_aliases
                WHERE speaker_id = ?
                ORDER BY alias COLLATE NOCASE
                """,
                (speaker["id"],)
            ).fetchall()

            speaker["aliases"] = [a["alias"] for a in aliases]
            result.append(speaker)

        return result


@app.post("/api/speakers")
def create_speaker(speaker: Speaker):
    name = speaker.name.strip()

    if not name:
        raise HTTPException(
            status_code=400,
            detail="Der Sprechername darf nicht leer sein."
        )

    aliases = list(dict.fromkeys(
        alias.strip()
        for alias in speaker.aliases
        if alias.strip() and alias.strip() != name
    ))

    with get_connection() as conn:
        cursor = conn.execute(
            """
            INSERT INTO speakers
            (name, birth_date, death_date, biography, notes)
            VALUES (?, ?, ?, ?, ?)
            """,
            (
                name,
                speaker.birth_date,
                speaker.death_date,
                speaker.biography,
                speaker.notes
            )
        )

        speaker_id = cursor.lastrowid

        for alias in aliases:
            conn.execute(
                """
                INSERT OR IGNORE INTO speaker_aliases
                (speaker_id, alias)
                VALUES (?, ?)
                """,
                (speaker_id, alias)
            )

        conn.commit()

        return {
            "id": speaker_id,
            "message": "Sprecher wurde angelegt."
        }


@app.get("/api/speakers/{speaker_id}")
def get_speaker(speaker_id: int):
    with get_connection() as conn:
        row = conn.execute(
            """
            SELECT *
            FROM speakers
            WHERE id = ?
            """,
            (speaker_id,)
        ).fetchone()

        if not row:
            raise HTTPException(
                status_code=404,
                detail="Sprecher nicht gefunden."
            )

        speaker = dict(row)

        aliases = conn.execute(
            """
            SELECT alias
            FROM speaker_aliases
            WHERE speaker_id = ?
            ORDER BY alias COLLATE NOCASE
            """,
            (speaker_id,)
        ).fetchall()

        speaker["aliases"] = [a["alias"] for a in aliases]

        return speaker


@app.put("/api/speakers/{speaker_id}")
def update_speaker(speaker_id: int, speaker: Speaker):
    name = speaker.name.strip()

    if not name:
        raise HTTPException(
            status_code=400,
            detail="Der Sprechername darf nicht leer sein."
        )

    aliases = list(dict.fromkeys(
        alias.strip()
        for alias in speaker.aliases
        if alias.strip() and alias.strip() != name
    ))

    with get_connection() as conn:
        existing = conn.execute(
            """
            SELECT id
            FROM speakers
            WHERE id = ?
            """,
            (speaker_id,)
        ).fetchone()

        if not existing:
            raise HTTPException(
                status_code=404,
                detail="Sprecher nicht gefunden."
            )

        conn.execute(
            """
            UPDATE speakers
            SET name = ?,
                birth_date = ?,
                death_date = ?,
                biography = ?,
                notes = ?
            WHERE id = ?
            """,
            (
                name,
                speaker.birth_date,
                speaker.death_date,
                speaker.biography,
                speaker.notes,
                speaker_id
            )
        )

        conn.execute(
            """
            DELETE FROM speaker_aliases
            WHERE speaker_id = ?
            """,
            (speaker_id,)
        )

        for alias in aliases:
            conn.execute(
                """
                INSERT OR IGNORE INTO speaker_aliases
                (speaker_id, alias)
                VALUES (?, ?)
                """,
                (speaker_id, alias)
            )

        conn.commit()

        return {
            "message": "Sprecher wurde aktualisiert."
        }


@app.delete("/api/speakers/{speaker_id}")
def delete_speaker(speaker_id: int):
    with get_connection() as conn:
        existing = conn.execute(
            "SELECT id FROM speakers WHERE id = ?",
            (speaker_id,)
        ).fetchone()

        if existing is None:
            raise HTTPException(
                status_code=404,
                detail="Sprecher nicht gefunden."
            )

        conn.execute(
            "DELETE FROM speaker_roles WHERE speaker_id = ?",
            (speaker_id,)
        )

        conn.execute(
            "DELETE FROM speaker_aliases WHERE speaker_id = ?",
            (speaker_id,)
        )

        conn.execute(
            "DELETE FROM speakers WHERE id = ?",
            (speaker_id,)
        )

        return {
            "message": "Sprecher und seine Verknüpfungen wurden gelöscht."
        }


# ============================================================
# SPRECHER – FIGUREN UND HÖRSPIELFOLGEN
# ============================================================

@app.get("/api/speakers/{speaker_id}/roles")
def get_speaker_roles(speaker_id: int):
    with get_connection() as conn:
        speaker = conn.execute(
            "SELECT id FROM speakers WHERE id = ?",
            (speaker_id,)
        ).fetchone()

        if not speaker:
            raise HTTPException(
                status_code=404,
                detail="Sprecher nicht gefunden."
            )

        rows = conn.execute(
            """
            SELECT
                sr.id AS role_id,
                p.id AS person_id,
                p.name AS person_name,
                e.id AS episode_id,
                e.episode_number,
                e.title AS episode_title,
                sr.role_notes
            FROM speaker_roles sr
            JOIN persons p ON p.id = sr.person_id
            JOIN episodes e ON e.id = sr.episode_id
            WHERE sr.speaker_id = ?
            ORDER BY e.episode_number, p.name COLLATE NOCASE
            """,
            (speaker_id,)
        ).fetchall()

        return [dict(row) for row in rows]


@app.post("/api/speakers/{speaker_id}/roles")
def create_speaker_role(
    speaker_id: int,
    assignment: SpeakerRole
):
    with get_connection() as conn:
        if not conn.execute(
            "SELECT id FROM speakers WHERE id = ?",
            (speaker_id,)
        ).fetchone():
            raise HTTPException(
                status_code=404,
                detail="Sprecher nicht gefunden."
            )

        if not conn.execute(
            "SELECT id FROM persons WHERE id = ?",
            (assignment.person_id,)
        ).fetchone():
            raise HTTPException(
                status_code=404,
                detail="Figur nicht gefunden."
            )

        if not conn.execute(
            "SELECT id FROM episodes WHERE id = ?",
            (assignment.episode_id,)
        ).fetchone():
            raise HTTPException(
                status_code=404,
                detail="Hörspielfolge nicht gefunden."
            )

        try:
            cursor = conn.execute(
                """
                INSERT INTO speaker_roles
                (speaker_id, person_id, episode_id, role_notes)
                VALUES (?, ?, ?, ?)
                """,
                (
                    speaker_id,
                    assignment.person_id,
                    assignment.episode_id,
                    assignment.role_notes
                )
            )

            conn.commit()

            return {
                "id": cursor.lastrowid,
                "message": "Sprecher-Figuren-Zuordnung wurde angelegt."
            }

        except sqlite3.IntegrityError:
            raise HTTPException(
                status_code=409,
                detail=(
                    "Diese Zuordnung zwischen Sprecher, Figur und Folge "
                    "existiert bereits."
                )
            )


@app.put("/api/speakers/{speaker_id}/roles/{role_id}")
def update_speaker_role(
    speaker_id: int,
    role_id: int,
    assignment: SpeakerRole
):
    with get_connection() as conn:
        if not conn.execute(
            "SELECT id FROM speakers WHERE id = ?",
            (speaker_id,)
        ).fetchone():
            raise HTTPException(
                status_code=404,
                detail="Sprecher nicht gefunden."
            )

        if not conn.execute(
            "SELECT id FROM persons WHERE id = ?",
            (assignment.person_id,)
        ).fetchone():
            raise HTTPException(
                status_code=404,
                detail="Figur nicht gefunden."
            )

        if not conn.execute(
            "SELECT id FROM episodes WHERE id = ?",
            (assignment.episode_id,)
        ).fetchone():
            raise HTTPException(
                status_code=404,
                detail="Hörspielfolge nicht gefunden."
            )

        try:
            cursor = conn.execute(
                """
                UPDATE speaker_roles
                SET person_id = ?,
                    episode_id = ?,
                    role_notes = ?
                WHERE id = ? AND speaker_id = ?
                """,
                (
                    assignment.person_id,
                    assignment.episode_id,
                    assignment.role_notes,
                    role_id,
                    speaker_id
                )
            )

            if cursor.rowcount == 0:
                raise HTTPException(
                    status_code=404,
                    detail="Sprecher-Figuren-Zuordnung nicht gefunden."
                )

            conn.commit()

            return {
                "message": "Sprecher-Figuren-Zuordnung wurde aktualisiert."
            }

        except sqlite3.IntegrityError:
            raise HTTPException(
                status_code=409,
                detail=(
                    "Diese Zuordnung existiert bereits. "
                    "Bitte prüfe Sprecher, Figur und Folge."
                )
            )


@app.delete("/api/speakers/{speaker_id}/roles/{role_id}")
def delete_speaker_role(speaker_id: int, role_id: int):
    with get_connection() as conn:
        cursor = conn.execute(
            """
            DELETE FROM speaker_roles
            WHERE id = ? AND speaker_id = ?
            """,
            (role_id, speaker_id)
        )

        conn.commit()

        if cursor.rowcount == 0:
            raise HTTPException(
                status_code=404,
                detail="Sprecher-Figuren-Zuordnung nicht gefunden."
            )

        return {
            "message": "Sprecher-Figuren-Zuordnung wurde gelöscht."
        }


